# Optional. Without these the app runs in fully functional demo mode (local persistence, local analyzer).
# Never put a model-provider API key here: VITE_* variables are public in the browser bundle.
# Point to YOUR server-side endpoint that holds the key and returns the Analysis JSON shape.
VITE_AI_ENDPOINT=
# Supabase (anon key is public by design; isolation comes from RLS, see supabase/schema.sql)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
