# ---- Server (set these in Hostinger's Node.js app settings; NEVER commit real values) ----
NODE_ENV=production
PORT=3001
# MySQL created in hPanel -> Databases
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# 32+ random characters. Encrypts provider API keys inside MySQL. Changing it makes stored keys unreadable.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=
# First admin account (created on first start; the password is never overwritten afterwards)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Public address of the site (no trailing slash); used for PayPal return/webhook URLs
PUBLIC_URL=
# Optional fallbacks. Prefer saving keys in the Admin panel (encrypted in MySQL).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
